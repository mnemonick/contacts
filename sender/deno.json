{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "tasks": {
    "watch": {
      "description": "Runs the sender and hot-reloads it on file changes",
      "command": "deno watch --permission-set=default sender.ts"
    },
    "validate": {
      "description": "Type-checks the sender",
      "command": "deno check sender.ts"
    },
    "start": {
      "description": "Serves the built frontend from ./public (port 2000)",
      "command": "deno run --permission-set=default sender.ts"
    },
    "wait": {
      "description": "Blocks until the sender accepts connections on port 2000 (CI)",
      "command": "deno run --permission-set=wait wait-on tcp:2000 --timeout 4000"
    }
  },
  "permissions": {
    "default": {
      "read": ["./public", "/etc/letsencrypt"],
      "net": true,
      "env": true
    },
    "wait": {
      "net": true,
      "env": true
    }
  }
}
