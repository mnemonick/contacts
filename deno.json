{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  "tasks": {
    "fix": {
      "description": "Lints, applies safe fixes and formats the whole repository with Biome",
      "command": "deno run --permission-set=biome @biomejs/biome check --write --error-on-warnings"
    },
    "check": {
      "description": "Checks lint and formatting of the whole repository without changing files (CI)",
      "command": "deno run --permission-set=biome @biomejs/biome ci --error-on-warnings"
    },
    "cspell": {
      "description": "Checks English and Russian spelling in the whole repository",
      "command": "deno run --permission-set=cspell cspell lint --no-progress --gitignore \"**\""
    },
    "gitleaks": {
      "description": "Scans the whole git history for committed secrets (needs Docker)",
      "command": "docker run --rm -v ./:/repo ghcr.io/gitleaks/gitleaks:v8.30.1 git /repo --no-banner --redact --verbose"
    },
    "verify": {
      "description": "Runs every static check: types, Biome, spelling, secrets. Tests are separate: deno task --cwd=tests test",
      "command": "deno task --recursive validate && deno task check && deno task cspell && deno task gitleaks"
    }
  },
  "workspace": ["./frontend", "./backend", "./sender", "./tests"],
  "lint": {
    "exclude": ["**"]
  },
  "fmt": {
    "exclude": ["**"]
  },
  "imports": {
    "~/": "./",
    "%/": "./backend/",
    "@biomejs/biome": "npm:@biomejs/biome@2.5.14",
    "@cspell/dict-ru_ru": "npm:@cspell/dict-ru_ru@2.3.3",
    "cspell": "npm:cspell@10.3.6",
    "@sentry/deno": "npm:@sentry/deno@^11.4.0",
    "@total-typescript/ts-reset": "npm:@total-typescript/ts-reset@0.6.1",
    "@std/http": "jsr:@std/http@1.1.3",
    "@std/path": "jsr:@std/path@1.1.6",
    "hono": "npm:hono@4.13.8",
    "wait-on": "npm:wait-on@^9.5.1"
  },
  "permissions": {
    "biome": {
      "run": true,
      "env": true
    },
    "cspell": {
      "read": true,
      "env": true,
      "sys": true
    }
  }
}
