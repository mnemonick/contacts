{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "~/*": ["./*"],
      "#/*": ["./frontend/*"],
      "%/*": ["./backend/*"],
      "$/*": ["./tests/*"]
    }
  }
}
