{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  "tasks": {
    "fix": {
      "description": "Lints, applies safe fixes and formats the whole repository with Biome",
      "command": "deno run --permission-set=biome @biomejs/biome check --write --error-on-warnings"
    },
    "check": {
      "description": "Checks lint and formatting of the whole repository without changing files (CI)",
      "command": "deno run --permission-set=biome @biomejs/biome ci --error-on-warnings"
    },
    "gitleaks": {
      "description": "Scans the whole git history for committed secrets (needs Docker)",
      "command": "docker run --rm --volume ./:/repo ghcr.io/gitleaks/gitleaks:v8.30.1 git /repo --no-banner --redact --verbose"
    }
  },
  "workspace": ["./frontend", "./backend", "./sender", "./tests"],
  "lint": {
    "exclude": ["**"]
  },
  "fmt": {
    "exclude": ["**"]
  },
  "imports": {
    "~/": "./",
    "#/": "./frontend/",
    "%/": "./backend/",
    "$/": "./tests/",
    "@biomejs/biome": "npm:@biomejs/biome@2.5.14",
    "@sentry/deno": "npm:@sentry/deno@^11.4.0",
    "@total-typescript/ts-reset": "npm:@total-typescript/ts-reset@0.6.1",
    "@std/http": "jsr:@std/http@1.1.3",
    "@std/path": "jsr:@std/path@1.1.6",
    "hono": "npm:hono@4.13.8",
    "wait-on": "npm:wait-on@^9.5.1",
    "pg-error-enum": "npm:pg-error-enum@^2.0.1",
    "postgres": "npm:postgres@^3.4.9",
    "postgres-shift": "npm:postgres-shift@1.0.2",
    "typescript": "npm:typescript@7.0.2",
    "@js-temporal/polyfill": "npm:@js-temporal/polyfill@0.5.1",
    "@sentry/react": "npm:@sentry/react@^11.4.0",
    "@sentry/vite-plugin": "npm:@sentry/vite-plugin@^5.4.0",
    "@types/react": "npm:@types/react@19.3.0",
    "@types/react-dom": "npm:@types/react-dom@19.3.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@2.0.3",
    "react": "npm:react@19.3.0",
    "react-dom": "npm:react-dom@19.3.0",
    "vite": "npm:vite@8.3.0",
    "wouter": "npm:wouter@3.11.0",
    "zustand": "npm:zustand@5.0.15",
    "@playwright/test": "npm:@playwright/test@1.63.0",
    "playwright": "npm:playwright@1.63.0"
  },
  "permissions": {
    "biome": {
      "run": true,
      "env": true
    }
  }
}
